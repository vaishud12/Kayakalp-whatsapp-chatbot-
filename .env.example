# =============================================================================
# Kaya — KayaKalp Clinic WhatsApp AI Assistant
# Copy this file to `.env` and fill in your real values. NEVER commit `.env`.
# =============================================================================

# --- Google Gemini (FAQ embeddings + image/PDF analysis) ---
# Used for: (1) embedding FAQ rows for the ChromaDB vector store (gemini-embedding-001),
# (2) image/PDF analysis with Gemini 3.1 Flash Lite (gemini-3.1-flash-lite).
# Get a key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- OpenRouter (for RAG answer drafting only) ---
# Primary model for drafting patient-friendly responses from retrieved FAQ context.
# Fallback models are tried when the primary is rate-limited or errors.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_TEXT_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,google/nemotron-3-super-v1:free

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_WEBHOOK_SECRET=change-me-to-another-random-string

# --- Google Calendar (for checking busy slots + creating events) ---
# Create a service account at console.cloud.google.com
# Enable Google Calendar API, share calendar with service account email
GOOGLE_CALENDAR_ID=your-calendar-id@gmail.com
GOOGLE_CREDENTIALS_PATH=./credentials/service-account.json

# --- Google Calendar OAuth2 (optional; required to email calendar invites) ---
# A bare service account (above) CANNOT invite attendees on a personal Gmail
# calendar — Google blocks it without Domain-Wide Delegation. Set these to
# authenticate as the doctor's real Google account instead, which restores
# native invite emails. Run `python scripts/google_oauth_setup.py` once you've
# set the client id/secret to get the refresh token. Leave all three blank to
# keep using the service account (events still get created, just without an
# automatic invite email).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Google Apps Script (booking website submission) ---
GOOGLE_APPS_SCRIPT_URL=

# --- Doctor approval ---
# Auto-approve after this many minutes if doctor doesn't respond
APPROVAL_TIMEOUT_MINUTES=10

# --- Weight-loss program enrollment (3rd menu option) ---
# Google Form sent to the patient right after they pick a plan. Plan names
# and prices live in src/booking.py (PLANS) — edit there to change them.
ENROLLMENT_FORM_URL=https://forms.gle/KFwguS13cwEbrSFn8

# --- Enrollment payments Google Sheet (skip form/payment for pre-paid patients) ---
# Before the enrollment flow starts, the patient's WhatsApp number is looked up
# in this sheet: if a row matches their phone AND payment status is "Paid",
# they are enrolled instantly — no enrollment form, no payment steps.
# SHARE the sheet (Viewer) with the service account email inside
# GOOGLE_CREDENTIALS_PATH or lookups will fail and everyone falls back to the
# normal form -> payment flow. Leave ENROLLMENT_SHEET_ID blank to disable.
# gid = the tab ID from the sheet URL (.../edit?gid=2001338576); blank = first tab.
ENROLLMENT_SHEET_ID=1MlxF33ryEkqVXdQSJ4zeP26zyea3HVDDCebDGfz1he4
ENROLLMENT_SHEET_GID=2001338576

# --- Enrollment Program-Tier Google Sheet (same-phone + same-program check) ---
# When a patient picks a weight-loss plan, BOTH their phone number AND the
# selected program are looked up in this sheet. Only a row that matches
# BOTH the phone AND the "Enrolled Program Tier" column, with Payment status
# "Paid", triggers the "already registered in <program>" message. So the same
# phone enrolling in a DIFFERENT program still receives the form.
# SHARE the sheet (Viewer) with the service account email inside
# GOOGLE_CREDENTIALS_PATH or lookups will fail and everyone falls back to the
# normal form -> payment flow. Leave ENROLLMENT_PROGRAM_SHEET_ID blank to disable.
ENROLLMENT_PROGRAM_SHEET_ID=1CiNi3VLTnL15KrH-3uSuFYh5cRBigk-MAE3AZoYF4QE
ENROLLMENT_PROGRAM_SHEET_GID=598348416

# --- Post-approval payment flow ---
# Google Form the patient must fill after booking approval
SCREENING_FORM_URL=https://forms.gle/CxMbYCzDyp9GxULB6
# UPI details shown to the patient for payment (REQUIRED for payment step)
UPI_ID=yourname@upi
UPI_PAYEE_NAME=Dr. Your Name
# Optional amount shown in the payment message (e.g. 499 or leave empty)
PAYMENT_AMOUNT=
# Payment reminder timeline: patient reminded at 24h, 3 days; doctor alerted after day 7 if unpaid
PAY_REMINDER_1_HOURS=24
PAY_REMINDER_2_DAYS=3
PAY_EXPIRY_DAYS=7

# --- Cashfree Payment Links (optional; auto-verified payment) ---
# When set, patients get a Cashfree hosted payment link instead of raw UPI
# instructions, and payment is confirmed automatically via webhook instead
# of the doctor reviewing a screenshot. Leave blank to keep the manual
# UPI + screenshot flow above.
# Get these from the Cashfree dashboard: Developers -> API Keys
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
# sandbox while testing, production when you go live (needs KYC on Cashfree)
CASHFREE_ENV=sandbox
# Cashfree dashboard -> Developers -> Webhooks -> set a secret there and paste it here.
# Leave blank to reuse CASHFREE_SECRET_KEY for webhook signature verification.
CASHFREE_WEBHOOK_SECRET= 

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
# Public URL where this server is reachable (for approval links in doctor messages)
# e.g. https://your-app.up.railway.app or your ngrok domain (base domain only, no path)
APP_BASE_URL=

# --- Clinic website (shown in the welcome message) ---
# Official website URL for clinic services and doctor information
WEBSITE_URL=https://www.kayakalpbydrlekha.com/

# --- Clinic contact (doctor's WhatsApp number for approval messages) ---
CLINIC_HOTLINE=+917666320828
